@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

include("${CMAKE_CURRENT_LIST_DIR}/ChessTargets.cmake")

foreach(_comp IN LISTS Chess_FIND_COMPONENTS)
    if(_comp STREQUAL "chess_gui")
        find_dependency(Qt6 COMPONENTS Core Widgets SvgWidgets QUIET)
        if (Qt6_FOUND AND TARGET Chess::chess_gui)
            set(Chess_chess_gui_FOUND TRUE)
        else()
            set(Chess_chess_gui_FOUND FALSE)
        endif()
    elseif (_comp STREQUAL "chess_core")
        set(Chess_chess_core_FOUND TRUE)
    else()
        set(Chess_${_comp}_FOUND FALSE)
    endif()
endforeach()

check_required_components(Chess)
